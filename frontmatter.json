{
  "$schema": "https://frontmatter.codes/frontmatter.schema.json",
  "frontMatter.content.pageFolders": [
    {
      "title": "content",
      "path": "[[workspace]]/content"
    },
    {
      "title": "imgs",
      "path": "[[workspace]]/static/imgs"
    }
  ],
  "frontMatter.content.publicFolder": "static",
  "frontMatter.framework.id": "hugo",
  "frontMatter.preview.host": "http://localhost:1313",
  "frontMatter.data.files": [
  {
    "id": "historialVoley",
    "title": "Historial Voley",
    "file": "[[workspace]]/data/historialVoley.json",
    "fileType": "json",
    "labelField": "id",
    "singleEntry": false,
    "schema": {
      "title": "historialVoley",
      "type": "object",
      "required": [
        "lugar",
        "categoria",
        "fecha",
        "id",
        "sets"
      ],
      "properties": {
        "id": {
          "type": "string",
          "title": "Id (DD-MM Categoria)"
        },
        "lugar": {
          "type": "string",
          "title": "Lugar"
        },
        "categoria": {
          "type": "string",
          "title": "Categoría"
        },
        "sets": {
          "type": "array",
          "title": "Sets",
          "items": {
            "type": "string"
          }
        },
        "fecha": {
          "type": "string",
          "title": "Fecha (DD-MM-AA hh:mm)"
        }
      }
    }
  },
  {
    "id": "abanderados",
    "title": "Abanderados",
    "file": "[[workspace]]/data/abanderados.json",
    "fileType": "json",
    "labelField": "mencion",
    "singleEntry": false,
    "schema": {
      "title": "Abanderado",
      "type": "object",
      "required": [
        "mencion",
        "nombre",
        "apellido",
        "curso",
        "especialidad"
      ],
      "properties": {
        "mencion": {
          "type": "string",
          "title": "Mención"
        },
        "nombre": {
          "type": "string",
          "title": "Nombre"
        },
        "apellido": {
          "type": "string",
          "title": "Apellido"
        },
        "curso": {
          "type": "string",
          "title": "Curso"
        },
        "especialidad": {
          "type": "string",
          "title": "Especialidad"
        }
      }
    }
  },
  {
    "id": "autoridades",
    "title": "Autoridades",
    "file": "[[workspace]]/data/autoridades.json",
    "fileType": "json",
    "labelField": "cargo",
    "singleEntry": false,
    "schema": {
      "title": "Autoridad",
      "type": "object",
      "required": [
        "cargo",
        "nombre",
        "apellido"
      ],
      "properties": {
        "cargo": {
          "type": "string",
          "title": "Cargo"
        },
        "nombre": {
          "type": "string",
          "title": "Nombre"
        },
        "apellido": {
          "type": "string",
          "title": "Apellido"
        },
        "titulo": {
          "type": "string",
          "title": "Titulo"
        }
      }
    }
  },
  {
    "id": "clubes",
    "title": "Clubes",
    "file": "[[workspace]]/data/clubes.json",
    "fileType": "json",
    "labelField": "nombre",
    "singleEntry": false,
    "schema": {
      "title": "Clubes",
      "type": "object",
      "required": [
        "nombre",
        "horario",
        "ubicacion",
        "descripcion"
      ],
      "properties": {
        "nombre": {
          "type": "string",
          "title": "Nombre"
        },
        "horario": {
          "type": "string",
          "title": "Horario"
        },
        "ubicacion": {
          "type": "string",
          "title": "Ubicación"
        },
        "descripcion": {
          "type": "string",
          "title": "Descripción"
        }
      }
    }
  },
  {
    "id": "historia",
    "title": "Historia",
    "file": "[[workspace]]/data/historia.json",
    "fileType": "json",
    "labelField": "año",
    "singleEntry": false,
    "schema": {
      "title": "Historia",
      "type": "object",
      "required": [
        "año",
        "historia"
      ],
      "properties": {
        "año": {
          "type": "string",
          "title": "Año"
        },
        "imagen": {
          "type": "string",
          "title": "Nombre de la imagen en content/Historia"
        },
        "historia": {
          "type": "string",
          "title": "Historia (Texto)"
        }
      }
    }
  },
  {
    "id": "contribuidores",
    "title": "Contribuidores",
    "file": "[[workspace]]/data/contribuidores.json",
    "fileType": "json",
    "labelField": "github",
    "singleEntry": false,
    "schema": {
      "title": "Contribuidores",
      "type": "object",
      "required": [
        "nombre",
        "apellido",
        "cargo",
        "id"
      ],
      "properties": {
        "nombre": {
          "type": "string",
          "title": "Nombre"
        },
        "apellido": {
          "type": "string",
          "title": "Apellido"
        },
        "cargo": {
          "type": "string",
          "title": "Cargo"
        },
        "github": {
          "type": "string",
          "title": "Github"
        },
        "id": {
          "type": "string",
          "title": "Id"
        }
      }
    }
  }
],
  "frontMatter.framework.startCommand": "hugo server -D --renderToMemory"
}